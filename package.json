{
  "name": "attendance-automation",
  "version": "1.0.0",
  "description": "Fills unfilled attendance days on the Priority portal with Playwright",
  "author": "Artur Polishchuk",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "attendance": "tsx src/attendance/run.ts",
    "attendance:dry": "tsx src/attendance/dry-run.ts",
    "telegram:chat-id": "tsx src/utils/telegram-chat-id.ts",
    "sync-schedule": "tsx src/utils/sync-schedule.ts src/attendance/attendance.json .github/workflows/attendance.yml",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@playwright/test": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "pr-checkmate": "3.0.2",
    "typescript": "^6.0.2"
  }
}
